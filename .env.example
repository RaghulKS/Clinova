# Copy to .env in each clone. Never commit .env.
GEMINI_API_KEY=            # use a different key on each laptop if you have two
DATABASE_URL=              # Tiger Cloud connection string, e.g. postgres://user:pass@host:port/tsdb?sslmode=require
NTFY_TOPIC=                # random string, e.g. clinova-7f3k9q2x; subscribe to it in the ntfy app
MAX_GEMINI_CALLS=12000     # hard budget per key, enforced by clinova/common/llm.py
GEMINI_CONCURRENCY=8
CLINOVA_MODE=live          # live during the build; the judges' default is demo
DEMO_NCT_ID=               # optional: force the backtest trial
SKIP_MIROFISH=             # optional: set to 1 to skip T16
