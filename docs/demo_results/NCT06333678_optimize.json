  "trial_id": "NCT06333678",
  "protocol": {
    "trial_id": "NCT06333678",
    "version_no": 0,
    "title": "A Study Comparing Sotorasib With Durvalumab in People With Non-Small Cell Lung Cancer (NSCLC)",
    "summary": "In this study, the researchers will look at whether having participants switch from durvalumab to sotorasib when they have detectable minimal residual disease (MRD) is an effective treatment approach for locally advanced non-small cell lung cancer (LA-NSCLC).\nThe researchers will see whether this switch to sotorasib can control LANSCLC longer compared to the treatment approach of staying on durvalumab (and not switching to sotorasib).",
    "phase": "phase2",
    "setting": "any",
    "randomized": true,
    "arms": [
      "continue standard of care (SOC) durvalumab treatment",
      "switch sotorasib treatment until progression"
    ],
